@{
}
@model List<Mission6.Models.Movie>

<h2>Joel Hilton Film Collection</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Category</td>
                <td>@movie.Director</td>
                <td>@movie.Rating</td>
                <td>@(movie.Edited.HasValue ? (movie.Edited.Value ? "Yes" : "No") : "")</td>
                <td>@movie.LentTo</td>
                <td>@movie.Notes</td>
            </tr>
        }
    </tbody>
</table>
