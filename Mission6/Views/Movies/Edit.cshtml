@{
}
@model Mission6.Models.Movie
<!--Page to edit movies-->
<h2>Edit Movie</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MovieID" />

    <!-- Title -->
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <!-- Year -->
    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" required min="1888" />
    </div>

    <!-- Director -->
    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" />
    </div>

    <!-- Rating -->
    <div class="form-group">
        <label asp-for="Rating"></label>
        <select asp-for="Rating" class="form-control" required>
            <option value="">-- Select Rating --</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <!-- Edited -->
    <div class="form-group">
        <label asp-for="Edited"></label>
        <select asp-for="Edited" class="form-control" required>
            <option value="">-- Select --</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <!-- Lent To -->
    <div class="form-group">
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control" />
    </div>

    <!-- Copied To Plex -->
    <div class="form-group">
        <label asp-for="CopiedToPlex"></label>
        <select asp-for="CopiedToPlex" class="form-control" required>
            <option value="">-- Select --</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <!-- Notes -->
    <div class="form-group">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" class="form-control" maxlength="25"></textarea>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<a asp-action="MovieList" class="btn btn-secondary">Back to List</a>